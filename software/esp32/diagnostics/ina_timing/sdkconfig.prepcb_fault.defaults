CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_DMOTOR_INA_ADDRESS=0x44
CONFIG_DMOTOR_ACQUISITION_UART=y
CONFIG_DMOTOR_TIMING_BATCHES=100
CONFIG_DMOTOR_TIMING_CYCLES=100
CONFIG_DMOTOR_SYNTHETIC_INPUTS=y
CONFIG_DMOTOR_INJECT_EVERY=25
CONFIG_DMOTOR_INJECT_DELAY=y
