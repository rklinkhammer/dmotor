+        const uint64_t n = pi_state & max_n;
+        pi_state = pi_state * 6364136223846793005ULL + 1;
+        const uint32_t d = static_cast<uint32_t>(pi_state) & max_d;
+        check_pi(n, d ? d : 1);
+    }
