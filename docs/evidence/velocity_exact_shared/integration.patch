+static void check_pi(uint64_t n, uint32_t d) {
+    if (dmotor::detail::divide_pi(n, d) != n / d) {
+        std::cerr << "bounded PI division mismatch\n";
+        std::exit(1);
+    }
+}
 int main() {
+    constexpr uint64_t max_n = (uint64_t{1} << 39) - 1;
+    constexpr uint32_t max_d = (uint32_t{1} << 20) - 1;
+    for (uint64_t n : {uint64_t{0}, uint64_t{1}, uint64_t{65536500000},
+                       uint64_t{419430400500}, max_n - 1, max_n}) {
+        for (uint32_t d : {1U, 2U, 1000U, 1000000U, max_d}) check_pi(n, d);
+    }
