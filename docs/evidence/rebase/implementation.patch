diff --git a/include/dmotor/detail/local_position.hpp b/include/dmotor/detail/local_position.hpp
new file mode 100644
index 0000000..18deaa8
--- /dev/null
+++ b/include/dmotor/detail/local_position.hpp
@@ -0,0 +1,54 @@
+#pragma once
+#include <cstdint>
+namespace dmotor {
+namespace detail {
+// A frame leaves one full horizon of headroom on either side. Public positions
+// remain signed 64-bit counts; only trajectory coordinates are rebased.
+constexpr unsigned local_position_bits = 28;
+constexpr uint32_t local_position_span = uint32_t{1} << local_position_bits;
+constexpr uint32_t local_position_mask = local_position_span - 1;
+struct LocalPosition {
+    uint32_t distance = 0;
+    bool forward = true;
+    bool terminal = false;
+};
+class RebasedPosition {
+  public:
+    LocalPosition sample(int64_t position, int64_t target, bool new_target) {
+        const uint64_t frame = static_cast<uint64_t>(position) >> local_position_bits;
+        const int32_t local = static_cast<int32_t>(static_cast<uint64_t>(position) &
+                                                  local_position_mask);
+        if (!primed_ || new_target || frame != frame_) {
+            // Rounding down to an aligned frame is safe even at INT64_MIN.
+            const int64_t origin = position - local;
+            frame_ = frame;
+            primed_ = true;
+            if (target >= origin) {
+                const uint64_t distance = static_cast<uint64_t>(target) -
+                                          static_cast<uint64_t>(origin);
+                terminal_ = distance <= 2 * local_position_span;
+                target_ = terminal_ ? static_cast<int32_t>(distance)
+                                    : static_cast<int32_t>(2 * local_position_span);
+            } else {
+                const uint64_t distance = static_cast<uint64_t>(origin) -
+                                          static_cast<uint64_t>(target);
+                terminal_ = distance <= local_position_span;
+                target_ = terminal_ ? -static_cast<int32_t>(distance)
+                                    : -static_cast<int32_t>(local_position_span);
+            }
+        }
+        // Range [-2*span+1, 2*span], so signed 32-bit subtraction cannot overflow.
+        const int32_t error = target_ - local;
+        LocalPosition result;
+        result.forward = error >= 0;
+        result.distance = static_cast<uint32_t>(error >= 0 ? error : -error);
+        result.terminal = terminal_;
+        return result;
+    }
+  private:
+    uint64_t frame_ = 0; // Only 36 significant bits; offset is frame << 28.
+    int32_t target_ = 0;
+    bool terminal_ = false, primed_ = false;
+};
+} // namespace detail
+} // namespace dmotor
diff --git a/tests/rebase_test.cpp b/tests/rebase_test.cpp
new file mode 100644
index 0000000..29b2618
--- /dev/null
+++ b/tests/rebase_test.cpp
@@ -0,0 +1,41 @@
+#include "dmotor/detail/local_position.hpp"
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <vector>
+static void check(bool value) {
+    if (!value) { std::cerr << "rebase mismatch\n"; std::exit(1); }
+}
+int main() {
+    using namespace dmotor::detail;
+    const int64_t span = local_position_span;
+    std::vector<int64_t> points = {INT64_MIN, INT64_MIN + 1, INT64_MAX - 1, INT64_MAX};
+    for (int64_t frame = -5; frame <= 5; ++frame)
+        for (int64_t delta : {-1LL, 0LL, 1LL}) points.push_back(frame * span + delta);
+    for (auto target : points) {
+        RebasedPosition window;
+        bool first = true;
+        // Forward/reverse traversal reuses the state through many frame crossings.
+        for (unsigned pass = 0; pass < 2; ++pass) {
+            for (unsigned i = 0; i < points.size(); ++i) {
+                const auto position = points[pass ? points.size() - 1 - i : i];
+                auto result = window.sample(position, target, first);
+                first = false;
+                const bool forward = target >= position;
+                const uint64_t distance = forward
+                    ? static_cast<uint64_t>(target) - static_cast<uint64_t>(position)
+                    : static_cast<uint64_t>(position) - static_cast<uint64_t>(target);
+                check(result.forward == forward);
+                if (result.terminal) check(result.distance == distance);
+                else check(distance > local_position_span && result.distance >= local_position_span);
+                check(result.distance <= 2 * local_position_span);
+                if (distance <= local_position_span) check(result.terminal);
+            }
+        }
+        // New target in an unchanged frame must invalidate the previous local target.
+        check(window.sample(0, 1, true).distance == 1);
+        check(window.sample(0, -1, true).distance == 1);
+        check(!window.sample(0, -1, false).forward);
+    }
+    std::cout << "rebase: signed endpoints, repeated forward/reverse frames and target replacement passed\n";
+}
